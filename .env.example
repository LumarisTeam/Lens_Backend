# ===== 基础配置 =====
APP_ENV=development
HTTP_ADDR=:8080
# 逗号分隔的可信代理 CIDR，为空表示不信任任何代理
TRUSTED_PROXIES=

# PostgreSQL DSN（支持 postgres:// 与 postgresql:// 两种 scheme）
# 本地联调用项目根目录的 docker compose 启动 PostgreSQL；生产环境形如：
#   postgresql://root:password@127.0.0.1:25432/postgres
DB_DSN=postgres://bug:bug@localhost:5432/bug_feedback?sslmode=disable

# ===== Redis（反馈中心缓存、校验码、防重放与限流）=====
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 反馈中心安全参数 =====
# 用于 AES-GCM 加密 feedback_center.secret_cipher；生产环境请使用至少 32 字节随机值
FEEDBACK_SECRET_KEY=change-me-to-a-long-random-feedback-secret
# 校验码有效期 / timestamp 允许偏移 / 反馈中心缓存 / 单 SN 每分钟校验次数
FEEDBACK_CODE_TTL_SECONDS=300
FEEDBACK_TIMESTAMP_WINDOW_SECONDS=300
FEEDBACK_CENTER_CACHE_TTL_SECONDS=600
FEEDBACK_RATE_LIMIT_PER_MINUTE=120

# ===== 对象存储（腾讯云 COS，S3 风格配置）=====
STORAGE_PROVIDER=s3
# COS SecretId / SecretKey
S3_ACCESS_KEY=your-secret-id
S3_SECRET_KEY=your-secret-key
# 桶名（含 appid）
S3_BUCKET=appuse-11111
S3_REGION=ap-gsda
# 桶访问域名（含桶名，虚拟主机式）。留空则按 S3_BUCKET + S3_REGION 推导。
S3_CDN_URL=https://appuse-11111.cos.ap-gsda.myqcloud.com
# 服务端点（不含桶名，仅服务级 API 使用，对象操作不依赖此项）
S3_ENDPOINT=https://cos.ap-gsda.myqcloud.com
# 对象 key 前缀
S3_BASE_PREFIX=uploads

# ===== 业务限制 =====
PRESIGN_GET_EXPIRE_SECONDS=900
UPLOAD_PRESIGN_EXPIRE_SECONDS=900
IMAGE_MAX_SIZE=5242880
IMAGE_MAX_COUNT=6
CONTENT_MAX_LENGTH=2000
CONTACT_MAX_LENGTH=128
ORPHAN_IMAGE_RETAIN_HOURS=24

# 管理员接口 Bearer Token（必填，请使用足够随机的值）
ADMIN_API_TOKEN=change-me-to-a-long-random-token

# ===== 限流配置 =====
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
FEEDBACK_DAILY_LIMIT=100

# ===== 超时与运维 =====
# 单请求超时（秒），0 表示禁用；DB/COS 操作随请求上下文一并取消
HTTP_TIMEOUT_SECONDS=90
# admin 接口独立限流（防 token 爆破；先于鉴权执行，维度为来源 IP）
ADMIN_RATE_LIMIT_RPS=10
ADMIN_RATE_LIMIT_BURST=30
# 可选 CORS 白名单（逗号分隔，如 https://admin.example.com），空表示不输出 CORS 头
CORS_ALLOWED_ORIGINS=
