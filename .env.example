# ===== 基础配置 =====
APP_ENV=development
HTTP_ADDR=:8080
# 逗号分隔的可信代理 CIDR，为空表示不信任任何代理
TRUSTED_PROXIES=

# 本地联调 PostgreSQL DSN（对应 docker-compose.yml）
DB_DSN=postgres://bug:bug@localhost:5432/bug_feedback?sslmode=disable

# ===== 腾讯云 COS 配置 =====
COS_REGION=ap-guangzhou
COS_BUCKET=your-bucket-1250000000
# 可选：COS 桶访问端点，格式必须是「完整桶域名」https://{bucket}.cos.{region}.myqcloud.com。
# 留空则按 COS_BUCKET + COS_REGION 自动推导。注意：不要填成 https://cos.{region}.myqcloud.com
# 这类不含桶名的服务端点，否则对象操作会缺失桶名而失败。
COS_ENDPOINT=
COS_ACCESS_KEY=your-secret-id
COS_SECRET_KEY=your-secret-key

# ===== 业务限制 =====
PRESIGN_GET_EXPIRE_SECONDS=900
UPLOAD_PRESIGN_EXPIRE_SECONDS=900
IMAGE_MAX_SIZE=5242880
IMAGE_MAX_COUNT=6
CONTENT_MAX_LENGTH=2000
CONTACT_MAX_LENGTH=128
ORPHAN_IMAGE_RETAIN_HOURS=24

# 管理员接口 Bearer Token（必填，请使用足够随机的值）
ADMIN_API_TOKEN=change-me-to-a-long-random-token

# ===== 限流配置 =====
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
FEEDBACK_DAILY_LIMIT=100
